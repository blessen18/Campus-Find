# CampusFind Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase Project URL (find in Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER expose to client — server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3006

# College domain for email validation (optional)
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN=ajce.edu.in

